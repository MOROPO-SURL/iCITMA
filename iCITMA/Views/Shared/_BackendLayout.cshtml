@{
    Layout = "_Layout";
}

@section styles {
    <style type="text/css">
        html, body {
            height: 100%;
            position: relative;
        }

        #main-container {
            min-height: 100vh; /* will cover the 100% of viewport */
            overflow: hidden;
            display: block;
            position: relative;
        }

        .nav-sidebar > .active {
            border-radius: 0;
        }

        #dashboard-sidebar a {
            color: #49fadb;
        }

        #dashboard-sidebar a:hover {
            color: #528078;
        }

        #dashboard-sidebar a.nav-link.active {
            color: white;
        }

        #dashboard-sidebar a.nav-link.active:hover {
            color: #49fadb;
        }
    </style>

    @RenderSection("styles", false)
}

@section scripts {
    <script type="text/javascript">
            $(document).ready(function () {
                $(document).on("click", "button.filter-form-reseter", function(e) {
                    $(e.target.form).find("select option").prop("selected", false);

                    $(e.target.form).find("input[type=text]").prop("value", '');

                    e.target.form.submit();
                });
            });
    </script>

    @RenderSection("scripts", false)
}

<div id="main-container">
    <div class="container-fluid">
        <div class="row">
            <div class="col-auto d-none d-md-block bg-dark pl-0">
                @await Component.InvokeAsync("DashboardSidebar")
            </div>
            <div role="main" class="col p-0">
                <nav class="navbar navbar-light bg-light shadow d-flex p-md-3">
                    <button class="d-md-none" type="button" data-toggle="collapse" data-target="#dashboard-floating-sidebar" aria-expanded="false" aria-label="Mostra Navegación">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="d-inline d-md-none">
                        <h3 class="text-center mb-0">iCITMA</h3>
                        <small class="text-muted">plataforma de gestión digital</small>
                    </div>
                    <h4  class="mb-0 d-none d-md-inline">
                        Plataforma de gestión digital
                    </h4>
                    <ul class="navbar-nav justify-content-end">
                        <li>
                            <button type="submit" class="btn btn-link text-dark" data-toggle="modal" data-target="#logout-modal-form"><span class="mdi mdi-logout-variant" style="margin-right: 4px;"></span>Salir</button>
                        </li>
                    </ul>
                </nav>

                <div class="modal fade" id="logout-modal-form" tabindex="-1" role="dialog" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="logout-modal-form-title">Cerrar Sesión</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            @using (Html.BeginForm("logout", "account", new { Area = "security"}, FormMethod.Post, true, null))
                            {
                                <div class="modal-body">
                                    <p class="mb-0">Está seguro que desea cerrar la sesión y salir del sistema?</p>
                                </div>

                                <div class="modal-footer" style="margin-top: 0;">
                                    <button type="submit" class="btn btn-danger">Salir</button>
                                    <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                
                @if (ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] != null)
                {
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb" style="border-radius: 0;">
                            @{
                                ICollection<BreadcrumbViewModel> breadcrumbs = ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] as ICollection<BreadcrumbViewModel>;

                                if (breadcrumbs != null)
                                {
                                    var total = breadcrumbs.Count();
                                    var count = 1;

                                    foreach (var breadcrumb in breadcrumbs)
                                    {
                                        if (count < total)
                                        {
                                                        <li class="breadcrumb-item"><a href="@breadcrumb.Url">@Html.Raw(breadcrumb.Caption)</a></li>
                                        }
                                        else
                                        {
                                                        <li class="breadcrumb-item active">@Html.Raw(breadcrumb.Caption)</li>
                                        }

                                        count++;
                                    }
                                }
                            }
                        </ol>
                    </nav>
                }
                <div class="container-fluid pl-4 pr-4 mt-3">                    
                    @{
                        var notificationEntries = TempData.Where(x => x.Key.EndsWith("-notification")).ToArray();

                        foreach (var extraNotificationEntry in notificationEntries)
                        {
                            var notification = JsonConvert.DeserializeObject<NotificationViewModel>(extraNotificationEntry.Value.ToString());

                            <div class="alert alert-dismissible fade show alert-@Html.Raw(notification.Type.ToString().ToLower())">
                                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                                @if (notification.Title != null)
                                {
                                    <h4>@GlobalViewLocalizationHelper.Localize(notification.Title, ViewLocalizer)</h4>
                                }

                                @if (notification.Message != null)
                                {
                                    @Html.Raw(GlobalViewLocalizationHelper.Localize(notification.Message, ViewLocalizer));
                                }

                                @if (notification.Messages != null)
                                {
                                    <ul>
                                        @foreach (var item in notification.Messages)
                                        {
                                            <li>@GlobalViewLocalizationHelper.Localize(item, ViewLocalizer)</li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                    }

                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
</div>