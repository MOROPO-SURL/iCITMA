@using MOROPO.Framework.Guama.Core.Security.Common.Presentation.Web.Frontend.Extensions
@using MOROPO.CITMA.CMG.iCITMA.Helpers.Localization;
@using MOROPO.CITMA.CMG.iCITMA.Extensions;

@model MOROPO.CITMA.CMG.iCITMA.Models.View.DashboardSidebarViewModel

<div id="dashboard-sidebar" style="position: relative; min-height: 100vh; z-index: 1000;  overflow-x: hidden; overflow-y: auto; /* Scrollable contents if viewport is shorter than content. */">
    <h1 class="text-center text-light m-4">iCITMA</h1>

    <div class="row ml-3 mt-4 mb-4">
        <div class="col-3 align-self-center p-0">
            @if (Model.UserProfile.ImageId == null)
            {
                <img src="~/img/default-person-picture.jpg" class="img-thumbnail rounded-circle border-0" style="max-width: 72px; width: 72px; min-width: 72px;" />
            }
            else
            {
                var imageSource = string.Format("/media/images/{0}.{1}", Model.UserProfile.ImageId, Model.UserProfile.ImageExtension);

                <img src="@imageSource" class="img-thumbnail rounded-circle border-0" style="max-width: 72px; width: 72px; min-width: 72px;" />
            }
        </div>
        <div class="col align-self-center">
            <div class="text-light text-truncate">@Model.UserProfile.Name</div>
            @if (!string.IsNullOrEmpty(Model.UserProfile.LastName))
            {
                <div class="text-light text-truncate">@Model.UserProfile.LastName</div>
            }
            <a asp-action="index" asp-controller="account" asp-area="security">Ver Perfil</a>
        </div>
    </div>
    
    <hr />
    
    <nav class="nav flex-column nav-pills nav-sidebar">
        @if (Context.Request.Path.Value == "/management/dashboard")
        {
            <a class="nav-link active" href="#"><span class="mdi mdi-cogs" style="margin-right: 4px;"></span>@GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer)</a>
        }
        else
        {
            <a class="nav-link" href="@Url.Action("index", "dashboard", new { area = string.Empty, key = string.Empty })"><span class="mdi mdi-cogs" style="margin-right: 4px;"></span>@GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer)</a>
        }
    </nav>

    @foreach (var group in Model.ManagementDashboardSections)
    {
        <p class="text-light" style="margin: 20px 16px 8px 16px; font-weight: bold;">@group.Key</p>
        <hr class="m-0 mb-1 bg-secondary" />
        <nav class="nav flex-column nav-pills nav-sidebar">
            @foreach (var item in group.Value)
            {
                if (User.IsAuthorized(item.Role))
                {
                    if (Context.Request.Path.Value.ToLower().StartsWith("/management/" + item.Area + "/" + item.Controller))
                    {
                        <a class="nav-link active" href="@Url.Action(item.Action, item.Controller, new { area = item.Area, sheet = string.Empty })">@item.ToIconographyHtmlString() <span>@GlobalViewLocalizationHelper.Localize(item.Title, ViewLocalizer)</span></a>
                    }
                    else if (string.IsNullOrEmpty(item.Area) && Context.Request.Path.Value.ToLower().StartsWith("/management/" + item.Controller))
                    {
                        <a class="nav-link active" href="@Url.Action(item.Action, item.Controller, new { area = item.Area, sheet = string.Empty })">@item.ToIconographyHtmlString() <span>@GlobalViewLocalizationHelper.Localize(item.Title, ViewLocalizer)</span></a>
                    }
                    else
                    {
                        <a class="nav-link" href="@Url.Action(item.Action, item.Controller, new { area = item.Area, sheet = string.Empty })">@item.ToIconographyHtmlString() <span>@GlobalViewLocalizationHelper.Localize(item.Title, ViewLocalizer)</span></a>
                    }
                }
                else
                {
                    <a class="nav-link disabled">
                        @item.ToIconographyHtmlString() <span>@GlobalViewLocalizationHelper.Localize(item.Title, ViewLocalizer)</span>
                    </a>
                }
            }
        </nav>
    }
</div>
