@model MOROPO.CITMA.CMG.iCITMA.Models.View.PersonInputViewModel
<div class="alert alert-dark">
    <details>
        @if (Model.LastName != null)
        {
            <summary class="h4 mb-0">@Model.Name @Model.LastName</summary>
        }
        else
        {
            <summary class="h4 mb-0">@Model.Name</summary>
        }
        <hr />
        <div class="row no-gutters">
            <div class="col-lg-2 col-md-4 col-sm-6 mb-2">
                @if (Model.ImageId != null)
                {
                    <img class="img-thumbnail rounded-circle" src="~/media/images/@Model.ImageId.@Model.ImageExtension" />
                }
                else
                {
                    <img class="img-thumbnail rounded-circle" src="~/img/default-person-picture.jpg" />
                }
            </div>
            <div class="col-lg-10 col-md-8 col-sm-6">
                <div class="card-block pl-3">
                    <div class="row">
                        <dl class="col-md-6">
                            <dt>@Html.DisplayNameFor(model => model.Name)</dt>
                            <dd>@Html.DisplayFor(model => model.Name)</dd>
                        </dl>
                        <dl class="col-md-6">
                            <dt>Alias</dt>
                            @if (Model.Alias == null)
                            {
                                <dd class="text-muted">---</dd>
                            }
                            else
                            {
                                <dd>@Model.Alias</dd>
                            }
                        </dl>
                        <dl class="col-md-12 mb-0">
                            <dt>@Html.DisplayNameFor(model => model.About)</dt>
                            @if (Model.About == null)
                            {
                                <dd class="mb-0 text-muted">---</dd>
                            }
                            else
                            {
                                <dd class="mb-0">@Model.About</dd>
                            }
                        </dl>
                    </div>
                </div>
            </div>
        </div>
    </details>
</div>

