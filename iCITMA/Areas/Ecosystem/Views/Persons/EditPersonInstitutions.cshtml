@model MOROPO.CITMA.CMG.iCITMA.Models.View.PersonInstitutionManagerViewModel

@{
    ViewData["Title"] = "Modificar Persona (Instituciones)";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-desktop-mac-dashboard\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Gestionar Personas",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}


@section styles {
    <link rel="stylesheet" href="~/lib/bootstrap-combobox/css/bootstrap-combobox.css" />
    <style type="text/css">
        #ImageFile {
            width: 0;
            height: 0;
            overflow: hidden;
        }

        .member-img {
            width: 85%;
            max-height: 330px;
        }

        .dropdown-toggle {
            border-radius: 0.25rem;
            border: 1px solid #ced4da;
            border-top-left-radius: 0;
            border-bottom-left-radius: 0;
            margin-left: -1px;
            line-height: 36px;
        }

            .dropdown-toggle::after {
                margin: 0 5px;
            }

        ul.dropdown-menu {
            width: 100%;
        }
    </style>
}

@section scripts {
    <script src="~/lib/bootstrap-combobox/js/bootstrap-combobox.js"></script>
    <script type="text/javascript">
        $('.member-select').combobox();
    </script>

}

<div class="card" style="margin-bottom: 20px;">
    <div class="card-header">
        <h4 class="mb-0">@ViewData["Title"]</h4>
        @await Html.PartialAsync("_ContextPartial.cshtml", Model.Person)
        <ul class="nav nav-tabs card-header-tabs">
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("edit", @Model.Person.Id)">Generales</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("managecontacts", @Model.Person.Id)">Contactos</a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" href="#">Instituciones</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("editpersonspecializations", @Model.Person.Id)">Especialidades</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("editpersondoctorates", @Model.Person.Id)">Doctorados</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("editpersonmasterys", @Model.Person.Id)">Maestrías</a>
            </li>
        </ul>
    </div>
    <div class="card-body">
        @if (Model.Institutions.Count() != 0)
        {
            <div class="row">
                @foreach (var item in Model.Institutions)
                {
                    <div class="col-xl-3 col-md-5 mb-3" style="margin-bottom: 20px;">
                        <div class="card">
                            @if (item.ImageId != null)
                            {
                                <img src="~/media/images/@item.ImageId.@item.ImageExtension" class="card-img-top" />
                            }
                            else
                            {
                                <img src="~/img/default-organization-picture.png" class="card-img-top" />
                            }
                            <div class="card-body">
                                <div>@item.Name</div>
                            </div>
                            <div class="card-footer">
                                <div class="btn-group btn-group-sm float-right">
                                    <button class="btn btn-light" data-toggle="modal" data-target="#descrip-@item.Id"><span class="mdi mdi-file-eye-outline"></span><span>Detalles</span></button>
                                    <button role="button" class="btn btn-danger" data-toggle="modal" data-target="#delete-key-word-program-@item.Id"><span class="mdi mdi-trash-can-outline"></span>Eliminar</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    await Html.RenderPartialAsync("_PersonInstitutionDetailPartial", @item);

                    @**@
                    <div class="modal fade" id="delete-key-word-program-@item.Id" tabindex="-1" role="dialog" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="delete-member-@item.Id-title">Eliminar Instituciones</h5>
                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>
                                @using (Html.BeginForm("RemovePersonInstitutionsn", "persons", new { key = Model.Person.Id }, FormMethod.Post, true, null))
                                {


                                    @Html.Hidden("InstitutionId", item.Id)

                                    <div class="modal-body">
                                        <p>Está seguro que desea eliminar la Institución <b>@item.Name</b>?</p>
                                    </div>

                                    <div class="modal-footer" style="margin-top: 0;">
                                        <button type="submit" class="btn btn-danger">Eliminar</button>
                                        <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
    <div class="text-muted font-italic">Aún no tiene Instituciones, haga clic en el botón agregar para comenzar ...</div>
        }
    </div>
    <div class="card-footer">
        <button type="button" class="btn btn-primary" href="#" data-toggle="modal" data-target="#add-member">Agregar</button>
        <a class="btn btn-light" href="@Url.Action("index")">Regresar al listado</a>
    </div>
    @await Html.PartialAsync("AddPersonInstitutionIdPartial", new MOROPO.CITMA.CMG.iCITMA.Models.View.PersonInstitutionInputViewModel
    {
    PersonId = Model.Person.Id,
    NotSelectedInstitutions = Model.NotSelectedInstitutions
    })
</div>

