@model MOROPO.CITMA.CMG.iCITMA.Models.View.PersonDisplayViewModel

@{
    ViewData["Title"] = "Eliminar Persona";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-desktop-mac-dashboard\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Gestionar Personas",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

<h3 class="mb-3 mt-4">Está seguro que desea eliminar la persona detallada a continuación?</h3>
<dl>
    <dt>Nombre</dt>
    <dd>@Model.Name</dd>
    <dt>Apellidos</dt>
    <dd>@Model.LastName</dd>
    <dt>Sexo</dt>
    <dd>@GlobalViewLocalizationHelper.Localize(Model.Sex.ToString())</dd>
</dl>
<hr />
@using (Html.BeginForm("delete", "persons", new { Area = "ecosystem", key = string.Empty }, FormMethod.Post, true, null))
{
    @Html.HiddenFor(model => model.Id)
    <div>
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a class="btn btn-light" href="@Url.Action("index")">Cancelar</a>
    </div>
}
