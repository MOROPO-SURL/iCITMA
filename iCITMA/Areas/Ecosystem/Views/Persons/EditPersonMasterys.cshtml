@model MOROPO.CITMA.CMG.iCITMA.Models.View.PersonInputViewModel

@{
    ViewData["Title"] = "Modificar Persona (Áreas de Investigación de Maestrías)";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-desktop-mac-dashboard\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Gestionar Personas",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

    @using (Html.BeginForm("editpersonmasterys", "persons", new { key = Model.Id }, FormMethod.Post, true, null))
{
    var selectableIndex = 0;
    <div class="card" style="margin-bottom: 20px;">
        <div class="card-header">
            <h4 class="mb-0">@ViewData["Title"]</h4>
            <ul class="nav nav-tabs card-header-tabs">
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("edit", @Model.Id)">Generales</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("managecontacts", @Model.Id)">Contactos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("editpersoninstitutions", @Model.Id)">Instituciones</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("editpersonspecializations", @Model.Id)">Especialidades</a>
                </li>                
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("editpersondoctorates", @Model.Id)">Doctorados</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active" href="#">Maestrías</a>
                </li>
            </ul>
        </div>
        <div class="card-body">
            <div class="row">

                @if (Model.MasterysToSelect != null || Model.MasterysToSelect.Count() > 0)
                    {
                    @foreach (var item in Model.MasterysToSelect)
                        {
                            <div class="col-md-4">
                            @Html.EditorFor(model => item, "SelectionDescriptedGuidIDItemInputViewModel", string.Format("MasterysToSelect[{0}]", selectableIndex++))
                            </div>
                        }
                    }
                   
            
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Modificar</button>
            <a class="btn btn-light" href="@Url.Action("index")">Regresar al listado</a>
        </div>
    </div>
}

