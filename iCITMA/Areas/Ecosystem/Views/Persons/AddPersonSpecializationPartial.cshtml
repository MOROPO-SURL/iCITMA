@model MOROPO.CITMA.CMG.iCITMA.Models.View.PersonSpecializationInputViewModel

<div class="modal fade" id="add-member" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="add-member-title">Agregar </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            @using (Html.BeginForm("AddPersonSpecializations", "persons", null, FormMethod.Post, true, null))
            {
                <div class="modal-body">
                    @Html.HiddenFor(model => model.PersonId)

                    @if (Model.NotSelectedSpecializations.Count > 0)
                    {
                        <div>
                            @Html.LabelFor(model => model.NotSelectedSpecializations, new { @class = "control-label" })
                            @Html.DropDownListFor(model => model.ResearchAreaId, Model.NotSelectedSpecializations, "Escriba para buscar la palabra ...", new { @class = "form-control member-select" })
                            @Html.ValidationMessageFor(model => model.ResearchAreaId, null, new { @class = "text-danger" })
                        </div>
                    }
                    else
                    {
                        <div class="text-muted font-italic">No hay más datos que puedan ser agregados a la persona</div>
                    }
                </div>

                <div class="modal-footer">
                    @if (Model.NotSelectedSpecializations.Count > 0)
                    {
                        <button type="submit" class="btn btn-primary">Agregar</button>
                    }
                    <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                </div>
            }
        </div>
    </div>
</div>




