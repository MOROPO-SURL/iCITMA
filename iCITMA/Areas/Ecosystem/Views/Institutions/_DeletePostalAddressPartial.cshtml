@using MOROPO.Framework.Guama.Location.Persistence.Entities;
@model MOROPO.CITMA.CMG.iCITMA.Models.View.InstitutionPostalContactDisplayViewModel

<div class="modal fade" id="delete-postaladdress-@Model.Id" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="delete-socialcontact-@Model.Id-title">Eliminar Dirección Postal</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            @using (Html.BeginForm("DeletePostalAddress", "Institutions", null, FormMethod.Post, true, null))
            {
                @Html.HiddenFor(model => model.Id)

                @Html.HiddenFor(model => model.InstitutionId)

                <div class="modal-body">
                    <p class="mb-0">Está seguro que desea eliminar esta dirección postal?</p>
                </div>

                <div class="modal-footer" style="margin-top: 0;">
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                    <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                </div>
            }
        </div>
    </div>
</div>


