@model MOROPO.CITMA.CMG.iCITMA.Models.View.InstitutionInputViewModel

@{
    ViewData["Title"] = "Modificar Institución";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Gestionar Instituciones",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@section styles{
    <link rel="stylesheet" type="text/css" href="~/lib/gijgo/combined/css/gijgo.css" />
    <style type="text/css">
        #ImageFile {
            width: 0;
            height: 0;
            overflow: hidden;
        }

        .social-icon {
            font-size: 18px;
            top: 2px;
            margin-left: 8px;
            margin-right: 8px;
        }
    </style>
}

@section scripts {
    <script src="~/lib/gijgo/combined/js/gijgo.js"></script>
    <script type="text/javascript">
        $('#CreatedAt').datepicker({
            uiLibrary: 'bootstrap4',
            modal: true,
            header: true,
            footer: true,
            format: 'dd/mm/yyyy',
            value: '@Model.CreatedAt?.ToString("dd/MM/yyyy")'
        });

        $(function () {           
            $(document).on("change", "#ImageFile", function () {               
                var files = !!this.files ? this.files : [];

                if (!files.length || !window.FileReader) return; // no file selected, or no FileReader support

                if (/^image/.test(files[0].type)) {
                    var reader = new FileReader();

                    reader.readAsDataURL(files[0]);

                    reader.onloadend = function () {
                        $('#ImageFilePreview').attr('src', this.result);
                    }
                }

            });
        });
    </script>
}

@using (Html.BeginForm("edit", "Institutions", new { Area = "ecosystem", key = string.Empty }, FormMethod.Post, true, new { enctype = "multipart/form-data"}))
{
    @Html.HiddenFor(model => model.Id)

    <div class="card mb-3 mt-4">
        <div class="card-header">
            <h4>@ViewData["Title"]</h4>
            <ul class="nav nav-tabs card-header-tabs">
                <li class="nav-item">
                    <a class="nav-link active" href="#">Generales</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("ManageContacts", Model.Id)">Contactos</a>
                </li>
            </ul>
        </div>

        <div class="card-body">
            <div class="row">
                <div class="col-lg-3 col-md-4 col-sm-4 mb-3">
                    <div class="card">
                        @if (Model.ImageId != null)
                        {
                            <img src="~/media/images/@Model.ImageId.@Model.ImageExtension" class="card-img-top" id="ImageFilePreview" />
                        }
                        else
                        {
                            <img src="~/img/default-organization-picture.png" class="card-img-top" id="ImageFilePreview" />
                        }

                        <label class="btn btn-light" style="border-top-left-radius: 0; border-top-right-radius: 0; margin-bottom: 0;">
                            @GlobalViewLocalizationHelper.Localize("Upload", ViewLocalizer) ...
                            @Html.EditorFor(model => model.ImageFile)
                        </label>
                    </div>
                    @Html.ValidationMessageFor(model => model.ImageFile, null, new { @class = "text-danger" })
                </div>
                <div class="col-lg-9 col-md-8">
                    <div class="mb-3">
                        @Html.LabelFor(model => model.Name, new { @class = "control-label" })
                        @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.Name, null, new { @class = "text-danger" })
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(model => model.Alia, new { @class = "control-label" })
                            @Html.TextBoxFor(model => model.Alia, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.Alia, null, new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(model => model.CreatedAt, new { @class = "control-label" })
                            @Html.TextBoxFor(model => model.CreatedAt, new { @class = "form-control", @readonly = "readonly" })
                            @Html.ValidationMessageFor(model => model.CreatedAt, null, new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(model => model.OwnerId, new { @class = "control-label" })
                            @Html.DropDownListFor(model => model.OwnerId, Model.OwnerSelectedListItems, "Ninguna", new { @class = "form-control"})
                            @Html.ValidationMessageFor(model => model.OwnerId, null, new { @class = "text-danger" })
                        </div>
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(model => model.RepresentativeId, new { @class = "control-label" })
                            @Html.DropDownListFor(model => model.RepresentativeId, Model.PersonSelectedListItems, "Ninguno", new { @class = "form-control"})
                            @Html.ValidationMessageFor(model => model.RepresentativeId, null, new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
            </div>
            <div>
                @Html.LabelFor(model => model.Description, new { @class = "control-label" })
                @Html.TextAreaFor(model => model.Description, 6, 0, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Description, null, new { @class = "text-danger" })
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Modificar</button>
            <a class="btn btn-light" href="@Url.Action("index")">Regresar al listado</a>
        </div>
    </div>
}