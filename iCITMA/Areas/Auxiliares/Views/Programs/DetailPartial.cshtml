@model MOROPO.CITMA.CMG.iCITMA.Models.View.ProgramDisplayViewModel


<!-- Modal -->
<div class="modal fade " id="descrip-@Model.Id" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Detalles</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h5>@Html.DisplayNameFor(model => model.Name)</h5>
                            <p>@Model.Name</p>
                        </div>
                        <div class="col-md-6">
                            <h5>@Html.DisplayNameFor(model => model.Code)</h5>
                            <p>@Model.Code</p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <h5>@Html.DisplayNameFor(model => model.StartDate)</h5>
                            <p>@Model.StartDate</p>
                        </div>
                        <div class="col-md-6">
                            <h5>@Html.DisplayNameFor(model => model.EndAt)</h5>
                            <p>@Model.EndAt</p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <h5>@Html.DisplayNameFor(model => model.Leader)</h5>
                            <p>@Model.Leader</p>
                        </div>
                        <div class="col-md-6">
                            <h5>@Html.DisplayNameFor(model => model.Category)</h5>
                            <p>@Model.Category</p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <h5>@Html.DisplayNameFor(model => model.Institution)</h5>
                            <p>@Model.Institution</p>
                        </div>
                        <div class="col-md-6">
                            <h5>@Html.DisplayNameFor(model => model.Amount)</h5>
                            <p>@Model.Amount</p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <h5>@Html.DisplayNameFor(model => model.FundingSource)</h5>
                            <p>@Model.FundingSource</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
