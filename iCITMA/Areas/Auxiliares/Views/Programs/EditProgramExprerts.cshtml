@model MOROPO.CITMA.CMG.iCITMA.Models.View.ProgramInputViewModel

@{
    ViewData["Title"] = "Editar Programa (Expertos)";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Programas",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@using (Html.BeginForm("EditProgramExprerts", "programs", new { key = Model.Id }, FormMethod.Post, true, null))
{
    var selectableIndex = 0;
    <div class="card" style="margin-bottom: 20px;">
        <div class="card-header">
            <h4 class="mb-0">@ViewData["Title"]</h4>
            <ul class="nav nav-tabs card-header-tabs">
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("edit", @Model.Id)">Generales</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active" href="#">Expertos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("EditProgramKeyWorlds", Model.Id)">Palabras Claves</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("EditProgramDocuments", Model.Id)">Documentos</a>
                </li>
            </ul>
        </div>
        <div class="card-body">
            <div class="row">

                @if (Model.ExpertsToSelect != null || Model.ExpertsToSelect.Count() > 0)
                {
                    @foreach (var item in Model.ExpertsToSelect)
                    {
                        <div class="col-md-4">
                            <div class="card" style="width: 18rem;">
                            @if(item.ImageId != System.Guid.Empty && item.ImageId != null)
                            {
                                <img src="~/media/images/@item.ImageId.@item.ImageExtension" class="card-img-top" alt="...">
                            }else
                            {
                                <img src="~/img/default-person-picture.jpg" class="card-img-top" alt="..." />
                            }
                                
                                <div class="card-body">
                                    <h5 class="card-title">@item.LabelDisplay</h5>
                                    <p class="card-text">@item.DescriptionDisplay</p>
                                    @Html.EditorFor(model => item, "SelectionDescriptedGuidIDItemInputViewModel", string.Format("ExpertsToSelect[{0}]", selectableIndex++))
                                </div>
                            </div>                            
                        </div>
                    }
                }


            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Modificar</button>
            <a class="btn btn-light" href="@Url.Action("index")">Regresar al listado</a>
        </div>
    </div>
}


