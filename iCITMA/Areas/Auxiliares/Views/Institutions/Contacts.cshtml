@model MOROPO.CITMA.CMG.iCITMA.Models.View.InstitutionContactsManageViewModel

@{
    ViewData["Title"] = "Editar Institución (Contactos)";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Instituciones",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@section styles {
    <style type="text/css">
        #ImageFile {
            width: 0;
            height: 0;
            overflow: hidden;
        }

        .social-icon {
            font-size: 18px;
            top: 2px;
            margin-left: 8px;
            margin-right: 8px;
        }
    </style>
}

@section scripts {
    <script type="text/javascript">

        $(function () {
            $('#StateId').on("change", function () {
                var stateId = $('#StateId').val();
                var state = $('#StateId option:selected').text();
                var obj = { state: stateId };
                AjaxCall('PopulateStateToMunicipality/' + stateId, stateId, 'GET').done(function (response) {
                    if (response.length > 0) {
                        $('#MunicipalityId').html('');
                        var options = '';
                        $('#AddressPostal').html('');
                        for (var i = 0; i < response.length; i++) {
                            console.log(response[i]);
                            options += '<option value="' + response[i].id + '">' + response[i].name + '</option>';
                        }
                        $('#MunicipalityId').append(options);
                    }
                });
            });
        });

        function AjaxCall(url, data, type) {
            console.log(url);
            return $.ajax({
                url: url,
                type: type ? type : 'GET',
                data: data,
                contentType: 'application/json'
            });
        }
    </script>
}

<div class="card" style="margin-bottom: 20px;">
    <div class="card-header">
        <h4>Editar Institución</h4>
        <ul class="nav nav-tabs card-header-tabs">
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("edit", @Model.Institution.Id)">Generales</a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" href="#">Contactos</a>
            </li>
        </ul>
    </div>
    <div class="card-body">
        @await Html.PartialAsync("_ContextDetailPartial.cshtml", Model.Institution)

        <div class="row">
            <div class="col-md-6" style="margin-bottom: 20px;">
                <div class="page-header">
                    <h4>Teléfonos<a class="btn btn-primary btn-sm float-right" href="#" data-toggle="modal" data-target="#add-phonecontact"><span class="mdi mdi-plus"></span> Agregar</a></h4>
                </div>


                @await Html.PartialAsync("AddPhoneContactPartial", new MOROPO.CITMA.CMG.iCITMA.Models.View.InstitutionPhoneContactInputViewModel
                {
                InstitutionId = Model.Institution.Id
                })

                <table class="table" style="margin: 0;">
                    <thead>
                        <tr>
                            <th>@GlobalViewLocalizationHelper.Localize("Number")</th>
                            <th>@GlobalViewLocalizationHelper.Localize("Label")</th>
                            <th style="width: 1px; white-space: nowrap;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.PhoneContacts.Count > 0)
                        {
                            @foreach (var item in Model.PhoneContacts)
                            {
                                <tr>
                                    <td style="vertical-align: middle;" title="@GlobalViewLocalizationHelper.Localize("Number")">@item.Number</td>
                                    <td style="vertical-align: middle;" title="@GlobalViewLocalizationHelper.Localize("Label")">@item.Label</td>
                                    <td style="vertical-align: middle;">
                                        <a role="button" href="#" class="btn btn-sm btn-danger" data-toggle="modal" data-target="#delete-phonecontact-@item.Id">Eliminar</a>
                                        @await Html.PartialAsync("DeletePhoneContactPartial", item)
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3"><p style="margin: 0 5px;" class="text-muted">Sin elementos que mostrar</p></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="col-md-6" style="margin-bottom: 20px;">
                <div class="page-header">
                    <h4>Correos Electrónicos<a class="btn btn-primary btn-sm float-right" href="#" data-toggle="modal" data-target="#add-nautacontact"><span class="mdi mdi-plus"></span> Agregar</a></h4>
                </div>
                @await Html.PartialAsync("AddEmailContactPartial", new MOROPO.CITMA.CMG.iCITMA.Models.View.InstitutionEmailContactInputViewModel
                {
                InstitutionId = Model.Institution.Id
                })
                <table class="table" style="margin: 0;">
                    <thead>
                        <tr>
                            <th>@GlobalViewLocalizationHelper.Localize("Email")</th>
                            <th>@GlobalViewLocalizationHelper.Localize("Label")</th>
                            <th style="width: 1px; white-space: nowrap;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.EmailContacts.Count > 0)
