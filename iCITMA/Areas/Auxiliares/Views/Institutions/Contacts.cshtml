                                    <td style="vertical-align: middle;" title="@GlobalViewLocalizationHelper.Localize("Longitude")">@item.Longitude</td>
                                    <td style="vertical-align: middle;" title="@GlobalViewLocalizationHelper.Localize("Provincia")">@item.State.Name</td>
                                    <td style="vertical-align: middle;" title="@GlobalViewLocalizationHelper.Localize("Municipio")">@item.Municipality.Name</td>
                                    <td style="vertical-align: middle;">
                                        <a role="button" href="#" class="btn btn-sm btn-danger" data-toggle="modal" data-target="#delete-postaladdress-@item.Id">Eliminar</a>
