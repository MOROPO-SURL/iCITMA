@using MOROPO.SAPRESSC.Core.Common.Models.View;

@model MOROPO.SAPRESSC.Middleware.Region.Web.Backend.Models.View.MunicipalityDisplayViewModel

@{
    ViewData["Title"] = "Eliminar Municipio";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Municipios",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

<h3>Esta seguro que desea eliminar el municipio detallado a continuación?</h3>

<dl>
    <dt>Municipio</dt>
    <dd>@Html.DisplayFor(model => model.Name)</dd>
    <dt>Provincia</dt>
    <dd>@Html.DisplayFor(model => model.State.Name)</dd>
    <dt>Pais</dt>
    <dd>@Html.DisplayFor(model => model.State.Country.Name)</dd>
</dl>
@using (Html.BeginForm("delete", "municipalities", new { Area = "Auxiliares", key = string.Empty }, FormMethod.Post, true, null))
{
    @Html.HiddenFor(model => model.Id)
    <div>
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a class="btn btn-default" href="@Url.Action("index")">Cancelar</a>
    </div>
}
