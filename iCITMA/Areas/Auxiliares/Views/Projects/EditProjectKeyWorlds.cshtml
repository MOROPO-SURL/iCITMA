@model MOROPO.CITMA.CMG.iCITMA.Models.View.ProjectInputViewModel

@{
    ViewData["Title"] = "Editar Proyecto (Palabras Claves)";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Proyectos",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@using (Html.BeginForm("EditProjectKeyWorlds", "projects", new { key = Model.Id }, FormMethod.Post, true, null))
{
    var selectableIndex = 0;
    <div class="card" style="margin-bottom: 20px;">
        <div class="card-header">
            <h4 class="mb-0">@ViewData["Title"]</h4>
            <ul class="nav nav-tabs card-header-tabs">
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("edit", @Model.Id)">Generales</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("ProgramExpectResults", Model.Id)">Prioridades que Tributa</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("EditProjectInstitutionParticipation", Model.Id)">Participantes</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active" href="#">Palabras Claves</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("EditProjectInstitutionClient", Model.Id)">Clientes</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">Objetivos específicos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">Resultados esperados</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">Impactos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">Salidas</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">Participantes </a>
                </li>
            </ul>
        </div>
        <div class="card-body">
            <div class="row">

                @if (Model.KeyWordsToSelect != null || Model.KeyWordsToSelect.Count() > 0)
                {
                    @foreach (var item in Model.KeyWordsToSelect)
                    {
                        <div class="col-md-4">
                            @Html.EditorFor(model => item, "SelectionDescriptedGuidIDItemInputViewModel", string.Format("KeyWordsToSelect[{0}]", selectableIndex++))
                        </div>
                    }
                }


            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Modificar</button>
            <a class="btn btn-light" href="@Url.Action("index")">Regresar al listado</a>
        </div>
    </div>
}



