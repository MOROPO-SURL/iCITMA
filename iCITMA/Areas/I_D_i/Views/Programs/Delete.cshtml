@model MOROPO.CITMA.CMG.iCITMA.Models.View.ProgramDisplayViewModel

@{
    ViewData["Title"] = "Eliminar Programa";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Administración de Programas",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

<h3>Está seguro que desea eliminar el programa detallado a continuación?</h3>
<dl>

    <dt>Nombre</dt>
    <dd>@Html.DisplayFor(model => model.Name)</dd>
    <dd>Código</dd>
    <dt>@Html.DisplayNameFor(model => model.Leader)</dt>
    <dt>Gestor</dt>
    <dd>@Html.DisplayFor(model => model.Manager)</dd>
    <dt>Jefe</dt>
    <dd>@Html.DisplayFor(model => model.Leader)</dd>   
</dl>

@using (Html.BeginForm("delete", "programs", new { Area = "I_D_i", key = string.Empty }, FormMethod.Post, true, null))
{
    @Html.HiddenFor(model => model.Id)
    <div>
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a class="btn btn-light" href="@Url.Action("index")">Cancelar</a>
    </div>
}
