@model MOROPO.CITMA.CMG.iCITMA.Models.View.ProgramDisplayViewModel

<!-- Modal -->
<div class="modal fade " id="descrip-@Model.Id" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Detalles</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <dl class="col-md-12 mb-0">
                        <dt>Nombre</dt>
                        <dd>@Model.Name</dd>
                    </dl>
                    <dl class="col-md-6 mb-0">
                        <dt>Código</dt>
                        <dd>@Model.Code</dd>
                    </dl>
                    <dl class="col-md-6 mb-0">
                        <dt>Categoría</dt>
                        <dd>@Model.Category</dd>
                    </dl>
                    <dl class="col-md-6 mb-0">
                        <dt>Fecha de Inicio</dt>
                        <dd>@Model.StartDate.ToShortDateString()</dd>
                    </dl>
                    <dl class="col-md-6 mb-0">
                        <dt>Fecha de Terminación</dt>
                        @if (Model.EndAt != null)
                        {
                            <dd>@Model.EndAt.Value.ToShortDateString()</dd>
                        }
                        else
                        {
                            <dd class="text-muted">---</dd>
                        }
                    </dl>
                    <dl class="col-md-6 mb-0">
                        <dt>Gestor</dt>
                        <dd>@Model.Manager</dd>
                    </dl>
                    <dl class="col-md-6 mb-0">
                        <dt>Jefe</dt>
                        <dd>@Model.Leader</dd>
                    </dl>
                    <dl class="col-md-12 mb-0">
                        <dt>Objetivos</dt>
                        @if (Model.Description != null)
                        {
                            <dd class="mb-0">@Model.Description</dd>
                        }
                        else
                        {
                            <dd class="mb-0 text-muted">---</dd>
                        }
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>
