@model MOROPO.CITMA.CMG.iCITMA.Models.View.ProgramExpertManagerViewModel

@{
    ViewData["Title"] = "Editar Programa (Expertos)";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Gestionar Programas",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@section styles {
    <link rel="stylesheet" href="~/lib/bootstrap-combobox/css/bootstrap-combobox.css" />
    <style type="text/css">
        .member-img {
            width: 85%;
            max-height: 330px;
        }

        .dropdown-toggle {
            border-radius: 0.25rem;
            border: 1px solid #ced4da;
            border-top-left-radius: 0;
            border-bottom-left-radius: 0;
            margin-left: -1px;
            line-height: 36px;
        }

            .dropdown-toggle::after {
                margin: 0 5px;
            }

        ul.dropdown-menu {
            width: 100%;
        }
    </style>
}

@section scripts {
    <script src="~/lib/bootstrap-combobox/js/bootstrap-combobox.js"></script>
    <script type="text/javascript">
        $('.member-select').combobox();
    </script>

}

<div class="card mb-3 mt-4">
    <div class="card-header">
        <h4>@ViewData["Title"]</h4>
        <ul class="nav nav-tabs card-header-tabs">
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("edit", @Model.Program.Id)">Generales</a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" href="#">Expertos</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("ManageKeyWorlds", Model.Program.Id)">Palabras Claves</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("ManageDocuments", Model.Program.Id)">Documentos</a>
            </li>
        </ul>
    </div>
    <div class="card-body pb-0">
        @if (Model.Experts.Count() != 0)
        {
            <div class="row">
                @foreach (var item in Model.Experts)
                {
                    <div class="col-xl-2 col-lg-4 col-md-6 mb-4 text-center">
                        @if (item.ImageId != null)
                        {
                            <img src="~/media/images/@item.ImageId.@item.ImageExtension" class="img-thumbnail rounded-circle w-75" />
                        }
                        else
                        {
                            <img src="~/img/default-person-picture.jpg" class="img-thumbnail rounded-circle w-75" />
                        }
                        <div class="mt-2">
                            @if (string.IsNullOrEmpty(item.LastName))
                            {
                                <div>@item.Name</div>
                            }
                            else
                            {
                                <div>@item.Name @item.LastName</div>
                            }
                            <div class="mt-2">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-light" data-toggle="modal" data-target="#descrip-@item.Id"><span class="mdi mdi-eye"></span> Detalles</button>
                                    <button role="button" class="btn btn-danger" data-toggle="modal" data-target="#delete-member-@item.Id"><span class="mdi mdi-trash-can-outline"></span> Eliminar</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    await Html.RenderPartialAsync("_ExpertDetailPartial", @item);
                    await Html.RenderPartialAsync("_DeleteExpertPartial", @item.ProgramExpert);
                }
            </div>
        }
        else
        {
            <div class="text-muted font-italic mb-4">Aun no tiene expertos, haga clic en el boton agregar para comenzar ...</div>
        }
    </div>
    <div class="card-footer">
        <button type="button" class="btn btn-primary" href="#" data-toggle="modal" data-target="#add-member">Agregar</button>
        <a class="btn btn-light" href="@Url.Action("index")">Regresar al listado</a>
    </div>

    @await Html.PartialAsync("_AddExpertPartial", new MOROPO.CITMA.CMG.iCITMA.Models.View.ProgramExpertInputViewModel
    {
        ProgramId = Model.Program.Id,
        NotSelectedExperts = Model.NotSelectedExperts
    })
</div>



