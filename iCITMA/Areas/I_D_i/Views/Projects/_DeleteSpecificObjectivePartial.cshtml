@model MOROPO.CITMA.CMG.iCITMA.Models.View.SpecificObjectiveDisplayViewModel

<div class="modal fade" id="delete-specific-objective-@Model.Id" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="delete-member-@Model.Id-title">Eliminar Objectivo</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            @using (Html.BeginForm("DeleteSpecificObjectives", "projects", null, FormMethod.Post, true, null))
            {
                @Html.HiddenFor(model => model.ProjectId)

                @Html.HiddenFor(model => model.Id)

                <div class="modal-body">
                    <p>Está seguro que desea eliminar el objetivo: <b>@Model.Objective</b>?</p>
                </div>

                <div class="modal-footer" style="margin-top: 0;">
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                    <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                </div>
            }
        </div>
    </div>
</div>

