@model MOROPO.CITMA.CMG.iCITMA.Models.View.ProjectParticipanDisplayViewModel

<div class="modal fade" id="delete-member-@Model.PersonId" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="delete-member-@Model.PersonId-title">Eliminar Participante</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            @using (Html.BeginForm("RemoveParticipan", "projects", null, FormMethod.Post, true, null))
            {
                @Html.HiddenFor(model => model.ProjectId)

                @Html.HiddenFor(model => model.PersonId)

                <div class="modal-body">
                    <p>Está seguro que desea eliminar el participante <b>@Model.Name</b> de nombre alias <b>@Model.Alias</b>?</p>
                </div>

                <div class="modal-footer" style="margin-top: 0;">
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                    <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                </div>
            }
        </div>
    </div>
</div>