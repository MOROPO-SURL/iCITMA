@model MOROPO.CITMA.CMG.iCITMA.Models.View.ProjectProgramExpectResultInputViewModel

<div class="modal fade" id="delete-expectresult-@Model.IdProgramExpectResult" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Resultados Esperados</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            @using (Html.BeginForm("DeleteExpectResult", "Projects", new { Area = "I_D_i", IdProgramExpectResult = Model.IdProgramExpectResult, ProjectId = Model.ProjectId }, FormMethod.Post, true, null))
            {
                @Html.HiddenFor(model => model.IdProgramExpectResult)
                @Html.HiddenFor(model => model.ProjectId)                


                <div class="modal-body">
                    <p>Está seguro que desea eliminar el Resultado esperado <b>@Model.Title</b> con descripción @Model.Description</p>
                </div>

                <div class="modal-footer" style="margin-top: 0;">
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                    <button type="button" class="btn btn-light" data-dismiss="modal">Cancelar</button>
                </div>
            }
        </div>
    </div>
</div>
