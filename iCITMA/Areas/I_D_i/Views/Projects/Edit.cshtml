@model MOROPO.CITMA.CMG.iCITMA.Models.View.ProjectInputViewModel

@{
    ViewData["Title"] = "Modificar Proyecto";

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-desktop-mac-dashboard\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = "Gestionar Proyectos",
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Title"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

@section styles{
    <link rel="stylesheet" type="text/css" href="~/lib/gijgo/combined/css/gijgo.css" />
}

@section scripts {
    <script src="~/lib/gijgo/combined/js/gijgo.js"></script>
    <script type="text/javascript">
        $('#StartAt').datepicker({
            uiLibrary: 'bootstrap4',
            modal: true,
            header: true,
            footer: true,
            format: 'dd-mm-yyyy'
        });

        $('#EndAt').datepicker({
            uiLibrary: 'bootstrap4',
            modal: true,
            header: true,
            footer: true,
            format: 'dd-mm-yyyy'
        });
    </script>
}

@using (Html.BeginForm("edit", "projects", new { Area = "I_D_i", key = string.Empty }, FormMethod.Post))
{
    @Html.HiddenFor(model => model.Id)

    <div class="card mb-3 mt-4">
        <div class="card-header">
            <h4>@ViewData["Title"]</h4>
            <ul class="nav nav-tabs card-header-tabs">
                <li class="nav-item">
                    <a class="nav-link active" href="#">Generales</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("ProgramExpectResults", Model.Id)">Prioridades que Tributa</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("EditProjectInstitutionParticipation", Model.Id)">Participantes</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("EditProjectKeyWorlds", Model.Id)">Palabras Claves</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("EditProjectInstitutionClient", Model.Id)">Clientes</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">Objetivos específicos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">Resultados Esperados</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("ProjectImpact", Model.Id)">Impactos</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("ProjectOutputKinds", Model.Id)">Salidas</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">Anexos</a>
                </li>
            </ul>
        </div>

        <div class="card-body">
            <div class="mb-3">
                @Html.LabelFor(model => model.Title, new { @class = "control-label" })
                @Html.TextBoxFor(model => model.Title, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Title, null, new { @class = "text-danger" })
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.Code, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.Code, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Code, null, new { @class = "text-danger" })
                </div>
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.StateId, new { @class = "control-label" })
                    @Html.DropDownListFor(model => model.StateId, Model.StateSelectListItems, "-- Seleccione --", new { @class = "form-control"})
                    @Html.ValidationMessageFor(model => model.StateId, null, new { @class = "text-danger" })
                </div>
            </div>
            <div class="row">                
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.ProgramId, new { @class = "control-label" })
                    @Html.DropDownListFor(model => model.ProgramId, Model.ProgramSelectListItems, "-- Seleccione --", new { @class = "form-control"})
                    @Html.ValidationMessageFor(model => model.ProgramId, null, new { @class = "text-danger" })
                </div>
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.CategoryId, new { @class = "control-label" })
                    @Html.DropDownListFor(model => model.CategoryId, Model.CategorySelectListItems, "-- Seleccione --", new { @class = "form-control"})
                    @Html.ValidationMessageFor(model => model.CategoryId, null, new { @class = "text-danger" })
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.StartAt, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.StartAt, new { @class = "form-control", @readonly = "readonly" })
                    @Html.ValidationMessageFor(model => model.StartAt, null, new { @class = "text-danger" })
                </div>
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.EndAt, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.EndAt, new { @class = "form-control", @readonly = "readonly" })
                    @Html.ValidationMessageFor(model => model.EndAt, null, new { @class = "text-danger" })
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.Budget, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.Budget, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Budget, null, new { @class = "text-danger" })
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.ManagerId, new { @class = "control-label" })
                    @Html.DropDownListFor(model => model.ManagerId, Model.InstitutionSelectListItems, "-- Seleccione --", new { @class = "form-control"})
                    @Html.ValidationMessageFor(model => model.ManagerId, null, new { @class = "text-danger" })
                </div>
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.LeaderId, new { @class = "control-label" })
                    @Html.DropDownListFor(model => model.LeaderId, Model.PersonSelectListItems, "-- Seleccione --", new { @class = "form-control"})
                    @Html.ValidationMessageFor(model => model.LeaderId, null, new { @class = "text-danger" })
                </div>
            </div>
            <div class="mb-3">
                @Html.LabelFor(model => model.Summary, new { @class = "control-label" })
                @Html.TextAreaFor(model => model.Summary, 6, 0, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Summary, null, new { @class = "text-danger" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(model => model.Problem, new { @class = "control-label" })
                @Html.TextAreaFor(model => model.Problem, 8, 0, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Problem, null, new { @class = "text-danger" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(model => model.Context, new { @class = "control-label" })
                @Html.TextAreaFor(model => model.Context, 10, 0, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Context, null, new { @class = "text-danger" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(model => model.MainObjetive, new { @class = "control-label" })
                @Html.TextAreaFor(model => model.MainObjetive, 6, 0, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.MainObjetive, null, new { @class = "text-danger" })
            </div>
            <div>
                @Html.LabelFor(model => model.Beneficiary, new { @class = "control-label" })
                @Html.TextAreaFor(model => model.Beneficiary, 8, 0, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Beneficiary, null, new { @class = "text-danger" })
            </div>        
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Modificar</button>
            <a class="btn btn-light" href="@Url.Action("index")">Cancelar</a>
        </div>
    </div>
}