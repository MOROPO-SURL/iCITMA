@model MOROPO.CITMA.CMG.iCITMA.Models.View.ProjectDisplayViewModel

<!-- Modal -->
<div class="modal fade " id="descrip-@Model.Id" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Detalles de @Model.Title</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">                    
                    <dl class="col-md-6 mb-0">
                        <dt>Representante</dt>
                        <dd>@Model.Manager</dd>
                    </dl>
                    <dl class="col-md-6 mb-0">
                        <dt>Programa</dt>
                        <dd>@Model.Program</dd>
                    </dl>
                    <dl class="col-md-6 mb-0">
                        <dt>Código</dt>
                        <dd>@Model.Code</dd>
                    </dl>
                    <dl class="col-md-6 mb-0">
                        <dt>Presupuesto:</dt>
                        <dd>@Model.Budget</dd>
                    </dl>
                    <dl class="col-md-6 mb-0">
                        <dt>Fecha de Inicio</dt>
                        <dd>@Model.StartAt.ToString()</dd>
                    </dl>
                    <dl class="col-md-6 mb-0">
                        <dt>Fecha de Terminación</dt>
                        <dd>@Model.EndAt.ToString()</dd>
                    </dl>                   
                    
                    <dl class="col-md-6 mb-0">
                        <dt>Participantes</dt>
                        @if(Model.Participants.Count() > 0 )
                        {
                            foreach (var participant in Model.Participants)
                            {
                                <dd>Nombre: @participant.Name </dd>                               

                            }
                        }
                        
                    </dl>
                    <dl class="col-md-6 mb-0">
                        <dt>Clientes</dt>
                        @if (Model.Clients.Count() > 0)
                        {
                            foreach (var participant in Model.Participants)
                            {
                                <dd>Nombre: @participant.Name </dd>
                                

                            }
                        }

                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>

