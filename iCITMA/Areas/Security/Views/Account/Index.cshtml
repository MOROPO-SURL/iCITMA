@model  MOROPO.CITMA.CMG.iCITMA.Models.View.UserProfileViewModel

@{
    ViewData["Heading"] = "Perfil de Usuario";

    ViewData["Title"] = ViewData["Heading"];

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<span class=\"mdi mdi-cogs\" style=\"margin-right: 4px;\"></span>" + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = "/"
        },
        new BreadcrumbViewModel
        {
            Caption = ViewData["Heading"].ToString()
        }
    };

    Layout = "_BackendLayout";
}

<div class="mt-4">
    <h3>@ViewData["Title"]</h3>
    <hr class="mb-4" />
</div>

<div class="row">
    <div class="col-xl-2 col-lg-3 col-md-4 col-sm-4">
        <div class="card">
            @if (Model.ImageId == null)
            {
                <img src="~/img/default-person-picture.jpg" class="card-img-top" id="ImageFilePreview" />
            }
            else
            {
                var imageSource = string.Format("/media/images/{0}.{1}", Model.ImageId, Model.ImageExtension);

                <img src="@imageSource" class="card-img-top" id="ImageFilePreview" />
            }
        </div>
    </div>
    <div class="col-xl-10 col-lg-9 col-md-8 col-sm-8">
        <dl>
            <dt>@GlobalViewLocalizationHelper.Localize("Login")</dt>
            <dd>@User.Identity.Name</dd>
        </dl>
        <div class="row">
            <dl class="col-md-6">                
                <dt>@GlobalViewLocalizationHelper.Localize("Name")</dt>
                <dd>@Model.Name</dd>
            </dl>
            <dl class="col-md-6">
                <dt>@GlobalViewLocalizationHelper.Localize("LastName")</dt>
                <dd>
                    @if (string.IsNullOrEmpty(Model.LastName))
                    {
                        <span class="text-muted">---</span>
                    }
                    else
                    {
                        <span>@Model.LastName</span>
                    }
                </dd>
            </dl>
        </div>
        <dl>
            <dt>@GlobalViewLocalizationHelper.Localize("Sex")</dt>
            <dd>@GlobalViewLocalizationHelper.Localize(Model.Sex.ToString())</dd>
        </dl>
        <dl class="mb-0">
            <dt>@GlobalViewLocalizationHelper.Localize("About")</dt>
            <dd>
                @if (Model.About == null)
                {
                    <span class="text-muted">---</span>
                }
                else
                {
                    <span>@Model.About</span>
                }
            </dd>
        </dl>
    </div>
</div>

<hr />

<div class="actions">
    <a asp-action="edit" class="btn btn-light"><span class="mdi mdi-square-edit-outline"></span> Modificar</a>
    <a asp-action="password" class="btn btn-light"><span class="mdi mdi-key-change"></span> Cambiar Contraseña</a>
</div>
